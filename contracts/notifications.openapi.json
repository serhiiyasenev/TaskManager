{
  "openapi": "3.1.0",
  "info": {
    "title": "TaskManager private notification inbox",
    "version": "1.1.0",
    "description": "Additive API1.0 boundary. Root owns contract; runtime/provider, frontend/consumer and transport agents review changes. Personal inbox responses/counts require current ownership AND current task/project permissions. id and messageId identify the same single-recipient event. Personal inbox filters deleted/moved/inaccessible tasks. Network hints may duplicate/drop; SQL is authoritative. Administrators can separately inspect a read-only retained overview across teams with current database role verification; recipient read markers remain owner-only."
  },
  "paths": {
    "/api/notifications": {
      "get": {
        "operationId": "GetNotificationInbox",
        "security": [
          {
            "TaskManagerCookie": []
          },
          {
            "LegacyBearer": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "unreadOnly",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Counts cover all current visible notifications, before paging and regardless of unreadOnly; page is ordered occurredAtUtc descending with ID tie break.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationInboxPage"
                }
              }
            }
          },
          "400": {

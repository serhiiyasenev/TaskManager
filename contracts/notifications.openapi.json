  "components": {
    "securitySchemes": {
      "TaskManagerCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-TaskManager.Session"
      },
      "LegacyBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "NotificationInboxItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "messageId",
          "kind",
          "taskId",
          "projectId",
          "taskName",
          "projectName",
          "occurredAtUtc"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3
            ]
          },
          "taskId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "projectId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "taskName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "projectName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "occurredAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "readAtUtc": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Absent is equivalent to null. First server UTC read time; repeated marking preserves it."
          }
        }
      },
      "NotificationInboxPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount",
          "unreadCount"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/NotificationInboxItem"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "unreadCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        }
      },
      "NotificationHint": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "notificationId"
        ],
        "properties": {
          "notificationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "description": "Authenticated SignalR InboxChanged hint; refetch canonical inbox. No task, user or private text fields."
      },

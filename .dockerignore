# Allow only the inputs needed by the application image build.
*
!global.json
!.config/
!.config/dotnet-tools.json
!package.json
!package-lock.json
!.npmrc
!.node-version
!src/
!src/backend/
!src/backend/DAL/
!src/backend/DAL/**
!src/backend/BLL/
!src/backend/BLL/**
!src/backend/WebAPI/
!src/backend/WebAPI/**
!src/backend/Notifier/
!src/backend/Notifier/**
!src/backend/Client/
!src/backend/Client/**
!src/backend/Hosting/
!src/backend/Hosting/**
!src/backend/WebHost/
!src/backend/WebHost/**
!tools/
!tools/TaskManager.SqlBootstrap/
!tools/TaskManager.SqlBootstrap/**
!src/frontend/
!src/frontend/**
# npm needs every workspace manifest; browser sources/private artifacts stay out.
!tests/
tests/**
!tests/frontend/
tests/frontend/**
!tests/frontend/package.json

# Configuration and credentials must not enter build context or image layers.
**/appsettings*.json
**/.env
**/.env.*
**/secrets.json
**/*.pfx
**/*.p12
**/*.pem
**/*.key
**/bin
**/obj
**/.vs
**/.tools
**/node_modules
src/frontend/dist
src/frontend/coverage
**/test-results
**/playwright-report
src/backend/WebHost/wwwroot
**/*.user
**/*.suo
**/*.log

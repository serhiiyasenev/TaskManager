{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "playwright.fullstack.config.ts", "e2e", "fullstack"]
}

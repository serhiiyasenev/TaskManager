# Local development only. Generate unique credentials with scripts/local-init.ps1.
# Keep .env private; never commit it or print docker compose config in shared logs.
COMPOSE_PROJECT_NAME=taskmanager-local
TASKMANAGER_IMAGE_TAG=local
MSSQL_SA_PASSWORD=
RABBITMQ_USER=taskmanager
RABBITMQ_PASSWORD=
TASKMANAGER_JWT_KEY=
API_PORT=8080
NOTIFIER_PORT=8081
PUBLIC_ORIGIN=https://localhost:7151
WEB_PORT=7151
GATEWAY_CERT_PATH=./.local/certificates/localhost.pfx
GATEWAY_CERT_PASSWORD=
COMPOSE_NETWORK_SUBNET=172.29.24.0/24
GATEWAY_IP=172.29.24.10
MAILPIT_PORT=8025
SQL_PORT=1433
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
